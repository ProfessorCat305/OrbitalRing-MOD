<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\ProjectOrbitalRing.csproj" />
  </ItemGroup>

  <Target Name="DeployPreloader" AfterTargets="Build" Condition="'$(DeployOnBuild)' == 'true'">
    <ItemGroup>
      <PatcherFiles Include="$(TargetPath);$(TargetDir)$(TargetName).pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(PatcherFiles)" DestinationFolder="$(BepinExPath)patchers\$(DebugModDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PatcherFiles)" DestinationFolder="$(ReleasePath)patchers" SkipUnchangedFiles="true" />
  </Target>
</Project>
